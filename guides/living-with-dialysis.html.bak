<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Living with Dialysis – W. G. M. Rivero, MD</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{--navy:#0f1e2e;--gold:#b8962e;--gold-light:#d4af4f;--teal:#1a6b72;--teal-light:#e1f5f0;--text:#1a1a1a;--text-muted:#5a6472;--border:#e2e6eb;--bg:#f9fafb;--white:#ffffff;--red:#c0392b;--red-soft:#fdf0ef;--amber:#f5a623;--amber-soft:#fef9ec;--green:#2d7a4f;--green-soft:#edf7f2;}
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'DM Sans',sans-serif;color:var(--text);background:var(--white);line-height:1.7;font-size:16px;}
  .hero{background:var(--navy);color:white;padding:72px 0 80px;position:relative;overflow:hidden;}
  .hero::before{content:'';position:absolute;top:-60px;right:-80px;width:420px;height:420px;border-radius:50%;border:1px solid rgba(184,150,46,.15);}
  .container{max-width:860px;margin:0 auto;padding:0 32px;}
  .hero-tag{display:inline-block;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-light);border:1px solid rgba(184,150,46,.4);padding:5px 14px;border-radius:20px;margin-bottom:24px;}
  .hero h1{font-family:'Lora',serif;font-size:clamp(30px,5vw,50px);font-weight:600;line-height:1.2;margin-bottom:20px;letter-spacing:-.02em;}
  .hero-sub{font-size:18px;color:rgba(255,255,255,.7);max-width:600px;line-height:1.65;margin-bottom:36px;}
  .hero-meta{display:flex;gap:32px;flex-wrap:wrap;font-size:13px;color:rgba(255,255,255,.5);}
  .hero-meta strong{color:rgba(255,255,255,.8);font-weight:500;}
  .nav-strip{background:var(--white);border-bottom:1px solid var(--border);position:sticky;top:56px;z-index:100;}
  .nav-pills{display:flex;gap:4px;padding:12px 32px;max-width:860px;margin:0 auto;overflow-x:auto;scrollbar-width:none;}
  .nav-pills::-webkit-scrollbar{display:none;}
  .nav-pill{white-space:nowrap;font-size:13px;font-weight:500;color:var(--text-muted);text-decoration:none;padding:6px 14px;border-radius:20px;border:1px solid transparent;transition:all .2s;}
  .nav-pill:hover{color:var(--navy);border-color:var(--border);background:var(--bg);}
  .section{padding:64px 0;border-bottom:1px solid var(--border);}
  .section:last-of-type{border-bottom:none;}
  .section-tag{font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--teal);margin-bottom:10px;}
  .section h2{font-family:'Lora',serif;font-size:clamp(22px,3.5vw,32px);font-weight:600;color:var(--navy);line-height:1.3;margin-bottom:20px;}
  .section p{color:var(--text-muted);margin-bottom:16px;}
  .section p:last-child{margin-bottom:0;}
  .intro-callout{background:var(--navy);color:white;border-radius:16px;padding:32px 36px;margin-bottom:36px;}
  .intro-callout p{color:rgba(255,255,255,.78);font-size:17px;line-height:1.75;margin:0;}
  .intro-callout p strong{color:white;font-weight:600;}
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:24px 0;}
  .three-col{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin:24px 0;}
  @media(max-width:600px){.two-col{grid-template-columns:1fr;}}
  .feature-card{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:20px;}
  .feature-card h4{font-size:14px;font-weight:600;color:var(--navy);margin-bottom:10px;display:flex;align-items:center;gap:8px;}
  .feature-card p{font-size:14px;color:var(--text-muted);margin:0;line-height:1.6;}
  .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
  .dot-teal{background:var(--teal);}.dot-red{background:var(--red);}.dot-amber{background:var(--amber);}.dot-green{background:var(--green);}.dot-navy{background:var(--navy);}
  .alert{border-radius:12px;padding:20px 24px;margin:24px 0;display:flex;gap:16px;align-items:flex-start;}
  .alert-red{background:var(--red-soft);border-left:3px solid var(--red);}
  .alert-amber{background:var(--amber-soft);border-left:3px solid var(--amber);}
  .alert-green{background:var(--green-soft);border-left:3px solid var(--green);}
  .alert-teal{background:var(--teal-light);border-left:3px solid var(--teal);}
  .alert-icon{font-size:20px;flex-shrink:0;margin-top:1px;}
  .alert-body h4{font-size:14px;font-weight:600;color:var(--navy);margin-bottom:6px;}
  .alert-body p{font-size:14px;color:var(--text-muted);margin:0;line-height:1.6;}
  .alert-body ul{font-size:14px;color:var(--text-muted);margin:6px 0 0 16px;}
  .alert-body ul li{margin-bottom:4px;line-height:1.5;}
  .lab-table{width:100%;border-collapse:collapse;margin:20px 0;font-size:14px;}
  .lab-table th{text-align:left;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);padding:10px 14px;background:var(--bg);border-bottom:1px solid var(--border);}
  .lab-table td{padding:12px 14px;border-bottom:1px solid var(--border);color:var(--text-muted);vertical-align:top;}
  .lab-table td:first-child{font-weight:500;color:var(--navy);}
  .lab-table tr:last-child td{border-bottom:none;}
  .lab-table tr:hover td{background:var(--bg);}
  .target-badge{display:inline-block;font-size:12px;font-weight:600;padding:2px 10px;border-radius:10px;background:var(--green-soft);color:var(--green);}
  .steps{margin:24px 0;}
  .step{display:flex;gap:20px;margin-bottom:24px;align-items:flex-start;}
  .step-num{width:36px;height:36px;background:var(--navy);color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;flex-shrink:0;}
  .step-body{flex:1;}
  .step-body h4{font-size:15px;font-weight:600;color:var(--navy);margin-bottom:6px;}
  .step-body p{font-size:14px;color:var(--text-muted);margin:0;}
  .pill-list{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0;}
  .pill{display:inline-block;font-size:13px;font-weight:500;padding:5px 14px;border-radius:20px;background:var(--teal-light);color:var(--teal);border:1px solid rgba(26,107,114,.2);}
  .red-flags{background:var(--red-soft);border:1px solid rgba(192,57,43,.2);border-radius:14px;padding:28px 32px;margin:32px 0;}
  .red-flags h3{font-family:'Lora',serif;font-size:18px;font-weight:600;color:var(--red);margin-bottom:16px;}
  .red-flags-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;}
  .red-flag-item{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:var(--text-muted);}
  .rf-dot{width:6px;height:6px;border-radius:50%;background:var(--red);flex-shrink:0;margin-top:7px;}
  .num-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin:24px 0;}
  .num-card{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:18px;text-align:center;}
  .num-card .n-val{font-family:'Lora',serif;font-size:26px;font-weight:600;color:var(--navy);line-height:1;}
  .num-card .n-label{font-size:12px;color:var(--text-muted);margin-top:6px;line-height:1.4;}
  .num-card .n-target{font-size:11px;font-weight:600;color:var(--green);margin-top:6px;}
  .hd-day-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0;}
  @media(max-width:600px){.hd-day-grid{grid-template-columns:1fr;}}
  .day-card{border-radius:12px;padding:20px;border:1px solid var(--border);}
  .day-card.hd-day{background:#fdf0ef;border-color:rgba(192,57,43,.2);}
  .day-card.non-hd-day{background:var(--green-soft);border-color:rgba(45,122,79,.2);}
  .day-card h4{font-size:14px;font-weight:600;margin-bottom:12px;}
  .day-card.hd-day h4{color:var(--red);}
  .day-card.non-hd-day h4{color:var(--green);}
  .day-card ul{font-size:13px;color:var(--text-muted);margin-left:16px;}
  .day-card ul li{margin-bottom:5px;line-height:1.5;}
  .dr-card{background:var(--navy);color:white;border-radius:16px;padding:32px;display:flex;gap:24px;align-items:flex-start;margin-top:48px;}
  .dr-avatar{width:56px;height:56px;background:rgba(184,150,46,.25);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;border:2px solid rgba(184,150,46,.4);}
  .dr-card h4{font-size:16px;font-weight:600;color:white;margin-bottom:4px;}
  .dr-card p{font-size:14px;color:rgba(255,255,255,.65);line-height:1.6;}
  .dr-card .dr-creds{font-size:12px;color:rgba(255,255,255,.45);margin-top:8px;}
  .guide-footer{background:var(--bg);border-top:1px solid var(--border);padding:40px 0;margin-top:64px;}
  .guide-footer .footer-inner{max-width:860px;margin:0 auto;padding:0 32px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
  .guide-footer p{font-size:13px;color:var(--text-muted);}
  .guide-footer a{color:var(--teal);text-decoration:none;font-weight:500;}
  .disclaimer{background:var(--amber-soft);border:1px solid rgba(245,166,35,.25);border-radius:10px;padding:16px 20px;margin:40px 0 0;font-size:13px;color:var(--text-muted);line-height:1.6;}
  .disclaimer strong{color:var(--navy);}

  /* ── DARK MODE ─────────────────────────────── */
  html[data-theme="dark"] {
    --navy:#0f1e2e; --gold:#b8962e; --gold-light:#d4af4f;
    --teal:#25949d; --teal-light:#0e2f32;
    --text:#e8eaf0; --text-muted:#8a95a8;
    --border:#2a3548; --bg:#141c2a; --white:#1a2030;
    --red:#e55; --red-soft:#2a1515; --amber:#f5a623; --amber-soft:#2a1f0a;
    --green:#3d9a6a; --green-soft:#0e2a1c; --purple:#9a6ed4; --purple-soft:#1a1030;
  }
  html[data-theme="dark"] body { background:#0f1520; color:#e8eaf0; }
  html[data-theme="dark"] .site-header { background:#080d16; }
  html[data-theme="dark"] .nav-strip { background:#141c2a; border-color:#2a3548; }
  html[data-theme="dark"] .hero { background:#080d16; }
  html[data-theme="dark"] .section { border-color:#2a3548; }
  html[data-theme="dark"] .intro-callout { background:#080d16; }
  html[data-theme="dark"] .feature-card,
  html[data-theme="dark"] .illus-wrap,
  html[data-theme="dark"] .ex-card,
  html[data-theme="dark"] .utox-card,
  html[data-theme="dark"] .modality-card,
  html[data-theme="dark"] .drug-card,
  html[data-theme="dark"] .tech-card,
  html[data-theme="dark"] .toxin-card,
  html[data-theme="dark"] .verdict-card{ background:#1a2535; border-color:#2a3548; }
  html[data-theme="dark"] .section h2,
  html[data-theme="dark"] .ex-name,
  html[data-theme="dark"] h3,
  html[data-theme="dark"] h4{ color:#e8eaf0; }
  html[data-theme="dark"] .section p,
  html[data-theme="dark"] .ex-desc,
  html[data-theme="dark"] .ex-steps{ color:#9aa5b8; }
  html[data-theme="dark"] .lab-table th { background:#1a2535; color:#8a95a8; }
  html[data-theme="dark"] .lab-table td { border-color:#2a3548; color:#9aa5b8; }
  html[data-theme="dark"] .lab-table td:first-child { color:#e8eaf0; }
  html[data-theme="dark"] .lab-table tr:hover td { background:#202d40; }
  html[data-theme="dark"] .dr-card { background:#080d16; }
  html[data-theme="dark"] .guide-footer { background:#141c2a; border-color:#2a3548; }
  html[data-theme="dark"] .schedule-table th { background:#1a2535; color:#8a95a8; }
  html[data-theme="dark"] .schedule-table td { border-color:#2a3548; color:#9aa5b8; }
  html[data-theme="dark"] .alert-teal { background:#0e2f32; }
  html[data-theme="dark"] .alert-amber { background:#2a1f0a; }
  html[data-theme="dark"] .alert-green { background:#0e2a1c; }
  html[data-theme="dark"] .alert-red { background:#2a1515; }
  html[data-theme="dark"] .stop-sign { background:#2a1515; }
  html[data-theme="dark"] .disclaimer { background:#2a1f0a; }
  /* ── DESKTOP FORCED MODE ────────────────────── */
  html[data-view="desktop"] { min-width:1024px; }
  html[data-view="desktop"] body { min-width:1024px; }
  /* ── TOGGLE BUTTON ──────────────────────────── */
  .guide-toggle-bar {
    display:flex; gap:8px; align-items:center;
    padding:6px 32px; background:rgba(0,0,0,.2);
    border-bottom:1px solid rgba(255,255,255,.06);
    justify-content:flex-end;
  }
  .toggle-btn {
    display:flex; align-items:center; gap:5px;
    background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.15);
    color:rgba(255,255,255,.7); font-family:'DM Sans',sans-serif;
    font-size:11px; font-weight:500; padding:4px 10px;
    border-radius:16px; cursor:pointer; transition:all .2s; white-space:nowrap;
  }
  .toggle-btn:hover { background:rgba(255,255,255,.15); color:white; }
  .toggle-btn.active { background:#b8962e; border-color:#b8962e; color:white; }
  .toggle-btn svg { width:12px; height:12px; flex-shrink:0; }
  @media(max-width:600px){ .toggle-label { display:none; } }


  /* ── PRINT ── */
  .print-btn{
    position:fixed;bottom:80px;right:24px;
    width:44px;height:44px;border-radius:50%;
    background:var(--teal,#1a6b72);color:white;
    border:none;cursor:pointer;display:flex;
    align-items:center;justify-content:center;
    box-shadow:0 4px 16px rgba(0,0,0,.25);
    transition:transform .2s,box-shadow .2s;
    z-index:9998;
  }
  .print-btn:hover{transform:scale(1.1);box-shadow:0 6px 20px rgba(0,0,0,.35);}
  .print-btn svg{width:18px;height:18px;}
  .print-btn .p-tip{
    position:absolute;right:54px;
    background:rgba(15,30,46,.9);color:white;
    font-size:12px;font-weight:500;white-space:nowrap;
    padding:5px 10px;border-radius:6px;
    opacity:0;pointer-events:none;transition:opacity .15s;
  }
  .print-btn:hover .p-tip{opacity:1;}
  @media print{
    .site-header,.nav-strip,.guide-toggle-bar,.print-btn,
    .float-controls,.guide-footer{display:none!important;}
    body{font-size:13px;line-height:1.6;color:#000;background:#fff;}
    .hero{background:#fff!important;color:#000!important;padding:24px 0 16px!important;}
    .hero h1{color:#0f1e2e!important;font-size:22px!important;}
    .hero-sub{color:#444!important;font-size:13px!important;}
    .hero-tag,.hero-meta{color:#666!important;}
    .container{max-width:100%;padding:0 24px;}
    .section{padding:20px 0;border-bottom:1px solid #ddd;}
    .intro-callout{background:#f0f4f8!important;color:#000!important;border:1px solid #ccc;}
    .intro-callout p{color:#222!important;}
    .alert{border:1px solid #ccc!important;background:#f9f9f9!important;}
    .alert-body h4,.alert-body p,.alert-body ul{color:#222!important;}
    .illus-wrap{border:1px solid #ccc;background:#f9f9f9!important;page-break-inside:avoid;}
    .illus-caption{color:#555!important;}
    .ex-card,.feature-card,.toxin-card,.utox-card,.modality-card{
      border:1px solid #ccc!important;background:#fff!important;page-break-inside:avoid;
    }
    .ex-name,.feature-card h4{color:#0f1e2e!important;}
    .ex-desc,.ex-steps,.feature-card p{color:#333!important;}
    .section h2{color:#0f1e2e!important;}
    .section-tag{color:#1a6b72!important;}
    .lab-table th{background:#eee!important;color:#333!important;}
    .lab-table td{color:#333!important;}
    .dr-card{background:#f0f4f8!important;color:#000!important;border:1px solid #ccc;}
    .dr-card h4,.dr-card p,.dr-card .dr-creds{color:#222!important;}
    .disclaimer{background:#fff8e8!important;border:1px solid #ccc!important;color:#333!important;}
    .stop-sign{background:#fff0f0!important;border:1px solid #c00!important;}
    a[href]:after{content:" (" attr(href) ")";font-size:10px;color:#666;}
    .nav-pill{display:none;}
    @page{margin:18mm 15mm;size:A4;}
  }


  /* ── LANGUAGE TOGGLE ── */
  .guide-toggle-bar { display:flex; gap:8px; align-items:center; padding:6px 32px; background:rgba(0,0,0,.18); border-bottom:1px solid rgba(255,255,255,.06); justify-content:flex-end; flex-wrap:wrap; }
  .lang-label { font-size:11px; color:rgba(255,255,255,.35); margin-right:4px; letter-spacing:.06em; }
  .lang-btn { font-family:'DM Sans',sans-serif; font-size:12px; font-weight:500; padding:4px 12px; border-radius:12px; border:1px solid rgba(255,255,255,.15); background:transparent; color:rgba(255,255,255,.55); cursor:pointer; transition:all .2s; }
  .lang-btn:hover { color:white; border-color:rgba(255,255,255,.4); }
  .lang-btn.active { background:#b8962e; border-color:#b8962e; color:white; }
  [data-lang].lang-hidden { display:none !important; }


  /* ── CONTRAST IMPROVEMENTS (v2) ── */

  /* Light-background text — darker for readability */
  .section > .container > p,
  .section p:not(.hero-sub):not(.intro-callout p) { color: #2c3340; }
  .feature-card p { color: #2c3340; }
  .feature-card h4 { color: #0f1e2e; }
  .alert-body p, .alert-body ul, .alert-body ul li { color: #2c3340; }
  .alert-body h4 { color: #0f1e2e; }
  .lab-table td { color: #2c3340; }
  .lab-table td:first-child { color: #0f1e2e; font-weight: 600; }
  .step-body p { color: #2c3340; }
  .step-body h4 { color: #0f1e2e; }
  .disclaimer { color: #2c3340; }
  .illus-caption { color: #2c3340; font-size: 13px; font-style: italic; margin-top: 12px; line-height: 1.65; display: block; }
  .intro-callout .illus-caption { color: rgba(255,255,255,.82) !important; font-style: italic; }
  .guide-footer p { color: #4a5260; }

  /* Light cards */
  .herb-card { background: #ffffff; }
  .herb-card h4 { color: #0f1e2e; }
  .herb-card .h-aka { color: #4a5260; }
  .herb-card p { color: #2c3340; }
  .myth-card.busted, .myth-card.partial, .myth-card.caution, .myth-card.true { background: #ffffff; }
  .myth-claim { color: #0f1e2e; }
  .myth-explanation { color: #2c3340; }
  .myth-explanation strong { color: #0f1e2e; }
  .alt-card p { color: #1e3a2a; }
  .req-block ul li { color: #2c3340; }
  .z-benefit { color: #2c3340; }
  .z-benefit .zb-label { color: #0f1e2e; }

  /* illus-wrap — slightly off-white so SVG text pops */
  .illus-wrap { background: #f0f4f8; }

  /* DARK-BACKGROUND PANELS — always white text, no exceptions */
  .intro-callout { background: #0f1e2e; }
  .intro-callout p { color: rgba(255,255,255,.92) !important; font-size: 16px; line-height: 1.75; margin: 0; }
  .intro-callout p strong { color: #ffffff !important; }
  .dr-card { background: #0f1e2e; }
  .dr-card h4 { color: #ffffff !important; }
  .dr-card p { color: rgba(255,255,255,.88) !important; }
  .dr-card .dr-creds { color: rgba(255,255,255,.55) !important; }
  .checklist { background: #0f1e2e; border-color: rgba(255,255,255,.1); }
  .checklist h4 { color: rgba(255,255,255,.95) !important; }
  .checklist ul li { color: rgba(255,255,255,.88) !important; border-color: rgba(255,255,255,.1); font-size: 14.5px; }
  .checklist ul li::before { color: #d4af4f; }
  .appt-form-header h3 { color: #ffffff !important; }
  .appt-form-header p { color: rgba(255,255,255,.6) !important; }
  .hero-sub { color: rgba(255,255,255,.88) !important; }
  .hero-meta { color: rgba(255,255,255,.6) !important; }
  .hero-meta strong { color: rgba(255,255,255,.9) !important; }

  /* Dark mode — keep all text legible */
  html[data-theme="dark"] .section p,
  html[data-theme="dark"] .feature-card p,
  html[data-theme="dark"] .alert-body p,
  html[data-theme="dark"] .alert-body ul li,
  html[data-theme="dark"] .step-body p,
  html[data-theme="dark"] .myth-explanation,
  html[data-theme="dark"] .lab-table td,
  html[data-theme="dark"] .disclaimer,
  html[data-theme="dark"] .req-block ul li,
  html[data-theme="dark"] .z-benefit,
  html[data-theme="dark"] .herb-card p,
  html[data-theme="dark"] .alt-card p{ color: #c0cad8 !important; }
  html[data-theme="dark"] .feature-card h4,
  html[data-theme="dark"] .step-body h4,
  html[data-theme="dark"] .myth-claim,
  html[data-theme="dark"] .z-benefit .zb-label,
  html[data-theme="dark"] .req-block h4{ color: #e8eaf0 !important; }
  html[data-theme="dark"] .illus-caption { color: #8a95a8; }
  html[data-theme="dark"] .illus-wrap { background: #1a2535; }
