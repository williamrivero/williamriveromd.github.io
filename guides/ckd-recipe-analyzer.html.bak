<button aria-label="Print" class="print-btn" onclick="window.print()">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
<polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect height="8" width="12" x="6" y="14"></rect>
</svg>
</button>
<script>
// ── THEME / LANG ──────────────────────────────────────────────────────
const DK='wgmr-dark',DSK='wgmr-desktop',GLK='wgmr-lang';
function applyDark(on){
  document.documentElement.setAttribute('data-theme',on?'dark':'light');
  const b=document.getElementById('darkToggle'),l=document.getElementById('darkLabel'),i=document.getElementById('darkIcon');
  if(b)b.classList.toggle('active',on);
  if(l)l.textContent=on?'Light':'Dark';
  if(i)i.innerHTML=on?'<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>':'<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
}
function toggleDark(){const on=document.documentElement.getAttribute('data-theme')!=='dark';localStorage.setItem(DK,on?'1':'0');applyDark(on);}
function applyDesktop(on){
  const vp=document.querySelector('meta[name="viewport"]');
  if(on){document.documentElement.setAttribute('data-view','desktop');if(vp)vp.setAttribute('content','width=1024');}
  else{document.documentElement.removeAttribute('data-view');if(vp)vp.setAttribute('content','width=device-width,initial-scale=1.0');}
  const b=document.getElementById('desktopToggle'),l=document.getElementById('desktopLabel');
  if(b)b.classList.toggle('active',on);if(l)l.textContent=on?'Mobile':'Desktop';
}
function toggleDesktop(){const on=document.documentElement.getAttribute('data-view')!=='desktop';localStorage.setItem(DSK,on?'1':'0');applyDesktop(on);}
function setLang(lang){
  localStorage.setItem(GLK,lang);
  ['en','tl','ceb'].forEach(l=>{
    document.querySelectorAll('[data-lang="'+l+'"]').forEach(el=>el.classList.toggle('lang-hidden',l!==lang));
    const btn=document.getElementById('glb-'+l);if(btn)btn.classList.toggle('active',l===lang);
  });
}
(function(){
  if(localStorage.getItem(DK)==='1')applyDark(true);
  if(localStorage.getItem(DSK)==='1')applyDesktop(true);
  const lang=localStorage.getItem(GLK)||'en';if(lang!=='en')setLang(lang);
})();

// ── STAGE ─────────────────────────────────────────────────────────────
let selectedStage = 'none';
function setStage(s, el){
  selectedStage = s;
  document.querySelectorAll('.stage-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
}

// ── EXAMPLE RECIPES ───────────────────────────────────────────────────
const examples = {
  tinola: {name:'Chicken Tinola',servings:4,desc:'1 bowl',ing:`300g chicken thighs, bone-in
1 medium sayote (chayote), cubed
1 cup malunggay leaves
1 tbsp patis (fish sauce)
3 cloves garlic, minced
1 medium onion, sliced
1 thumb-size ginger, julienned
1 tbsp vegetable oil
4 cups water
salt to taste`},
  sinigang: {name:'Pork Sinigang',servings:4,desc:'1 bowl',ing:`400g pork belly, sliced
2 medium tomatoes
1 medium onion
2 cups kangkong leaves
1 cup green beans (sitaw)
1 medium radish (labanos), sliced
2 pcs eggplant (talong)
2 tbsp tamarind soup base (sampaloc mix)
1 tbsp patis
6 cups water`},
  tortang_talong: {name:'Tortang Talong',servings:2,desc:'1 piece',ing:`2 medium eggplants (talong)
2 whole eggs
1 tbsp patis
1/4 tsp ground black pepper
2 tbsp vegetable oil
2 cloves garlic`}
};
function loadExample(key){
  const ex = examples[key];
  document.getElementById('f-name').value = ex.name;
  document.getElementById('f-servings').value = ex.servings;
  document.getElementById('f-serving-desc').value = ex.desc;
  document.getElementById('f-ingredients').value = ex.ing;
}

// ── CKD LIMITS ────────────────────────────────────────────────────────
const CKD_LIMITS = {
  none:  {na:2300,  k:null,  p:null,  note:'General healthy limits applied.'},
  '1':   {na:2300,  k:null,  p:400,   note:'Stage 1–2: minimal restriction needed.'},
  '3a':  {na:2300,  k:3000,  p:1000,  note:'Stage 3a: moderate monitoring.'},
  '3b':  {na:2300,  k:2500,  p:900,   note:'Stage 3b: increased restriction.'},
  '4':   {na:2300,  k:2000,  p:800,   note:'Stage 4: significant restriction required.'},
  '5':   {na:2300,  k:2000,  p:800,   note:'Stage 5: strict restriction; monitor closely.'},
  'HD':  {na:2000,  k:2000,  p:800,   note:'Hemodialysis: strict limits. Potassium between sessions is critical.'},
  'PD':  {na:2000,  k:2500,  p:800,   note:'Peritoneal Dialysis: strict sodium; potassium slightly more flexible.'},
};

// ── NUTRITION FACTS LABEL BUILDER ─────────────────────────────────────
function buildNFLabel(n, recipeName, servings, servingDesc){
  const pct = (val, dv) => val==null||dv==null ? '' : Math.round(val/dv*100)+'%';
  return `
  <div class="nf-title">Nutrition Facts</div>
  <div class="nf-servings">${servings} servings per recipe</div>
  <div class="nf-servings" style="display:flex;justify-content:space-between;font-weight:700;font-size:14px;">
    <span>Serving size</span><span>${servingDesc||'1 serving'}</span>
  </div>
  <div class="nf-thick"></div>
  <div style="font-size:11px;text-align:right;font-weight:700;">Amount per serving</div>
  <div class="nf-cal-row">
    <span class="nf-cal-label">Calories</span>
    <span class="nf-cal-val">${Math.round(n.calories)}</span>
  </div>
  <div class="nf-med"></div>
  <div class="nf-dv-header">% Daily Value*</div>
  <div class="nf-thin"></div>
  <div class="nf-row"><span class="nf-row-label bold">Total Fat</span><span>${n.fat?.toFixed(1)}g</span><span class="nf-row-pct">${pct(n.fat,78)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row nf-row-indent"><span class="nf-row-label">Saturated Fat</span><span>${n.sat_fat?.toFixed(1)}g</span><span class="nf-row-pct">${pct(n.sat_fat,20)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row nf-row-indent"><span class="nf-row-label"><i>Trans</i> Fat</span><span>${n.trans_fat?.toFixed(1)}g</span><span class="nf-row-pct"></span></div>
  <div class="nf-thin"></div>
  <div class="nf-row"><span class="nf-row-label bold">Cholesterol</span><span>${Math.round(n.cholesterol)}mg</span><span class="nf-row-pct">${pct(n.cholesterol,300)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row"><span class="nf-row-label bold">Sodium</span><span>${Math.round(n.sodium)}mg</span><span class="nf-row-pct">${pct(n.sodium,2300)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row"><span class="nf-row-label bold">Total Carbohydrate</span><span>${Math.round(n.carbs)}g</span><span class="nf-row-pct">${pct(n.carbs,275)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row nf-row-indent"><span class="nf-row-label">Dietary Fiber</span><span>${n.fiber?.toFixed(1)}g</span><span class="nf-row-pct">${pct(n.fiber,28)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row nf-row-indent"><span class="nf-row-label">Total Sugars</span><span>${n.sugars?.toFixed(1)}g</span><span class="nf-row-pct"></span></div>
  <div class="nf-thin"></div>
  <div class="nf-row"><span class="nf-row-label bold">Protein</span><span>${n.protein?.toFixed(1)}g</span><span class="nf-row-pct"></span></div>
  <div class="nf-med"></div>
  <div class="nf-row"><span class="nf-row-label">Potassium</span><span>${Math.round(n.potassium)}mg</span><span class="nf-row-pct">${pct(n.potassium,4700)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row"><span class="nf-row-label">Phosphorus</span><span>${Math.round(n.phosphorus)}mg</span><span class="nf-row-pct">${pct(n.phosphorus,1250)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row"><span class="nf-row-label">Calcium</span><span>${Math.round(n.calcium)}mg</span><span class="nf-row-pct">${pct(n.calcium,1300)}</span></div>
  <div class="nf-thin"></div>
  <div class="nf-row"><span class="nf-row-label">Iron</span><span>${n.iron?.toFixed(1)}mg</span><span class="nf-row-pct">${pct(n.iron,18)}</span></div>
  <div class="nf-footer">*The % Daily Value tells you how much a nutrient in a serving contributes to a 2,000 calorie daily diet.</div>
  `;
}

// ── CKD FLAGS BUILDER ─────────────────────────────────────────────────
function buildFlags(n, stage){
  const lim = CKD_LIMITS[stage] || CKD_LIMITS['none'];
  const flags = [];
  const stageLabels = {none:'General',1:'Stage 1–2','3a':'Stage 3a','3b':'Stage 3b',4:'Stage 4',5:'Stage 5',HD:'Hemodialysis',PD:'Peritoneal Dialysis'};
  const stageName = stageLabels[stage] || 'General';

  // Sodium
  const naLim = lim.na;
  const naPerMeal = naLim / 3;
  if(n.sodium > naPerMeal * 1.5){
    flags.push({cls:'danger',icon:'🚨',title:`High Sodium — ${Math.round(n.sodium)} mg per serving`,body:`Exceeds the ${stageName} meal limit of ~${Math.round(naPerMeal)} mg. ${stage==='HD'||stage==='PD'?'Each gram of excess sodium adds ~200 mL of retained fluid — directly worsening inter-dialytic weight gain.':'Reduces blood pressure control and accelerates CKD progression.'}`,values:`This serving: ${Math.round(n.sodium)} mg · Meal target: &lt;${Math.round(naPerMeal)} mg`});
  } else if(n.sodium > naPerMeal){
    flags.push({cls:'warn',icon:'⚠️',title:`Sodium Approaching Limit — ${Math.round(n.sodium)} mg per serving`,body:`Near the ${stageName} per-meal sodium limit. Consider reducing patis, toyo, or salt in this recipe. Calamansi juice is an excellent flavor substitute.`,values:`This serving: ${Math.round(n.sodium)} mg · Meal target: &lt;${Math.round(naPerMeal)} mg`});
  } else {
    flags.push({cls:'ok',icon:'✓',title:`Sodium OK — ${Math.round(n.sodium)} mg per serving`,body:`Within safe limits for ${stageName}.`,values:`${Math.round(n.sodium)} mg of ${Math.round(naPerMeal)} mg meal limit`});
  }

  // Potassium
  if(lim.k){
    const kPerMeal = lim.k / 3;
    if(n.potassium > kPerMeal * 1.5){
      flags.push({cls:'danger',icon:'🚨',title:`High Potassium — ${Math.round(n.potassium)} mg per serving`,body:`Exceeds safe limit for ${stageName}. Hyperkalemia (serum K &gt;5.5) risk. ${stage==='HD'?'Between dialysis sessions, potassium accumulates — high-potassium meals are particularly dangerous on days before dialysis.':'Monitor serum potassium closely.'} Consider removing or replacing the highest-potassium ingredient in this recipe.`,values:`This serving: ${Math.round(n.potassium)} mg · Meal target: &lt;${Math.round(kPerMeal)} mg`});
    } else if(n.potassium > kPerMeal){
      flags.push({cls:'warn',icon:'⚠️',title:`Potassium Elevated — ${Math.round(n.potassium)} mg per serving`,body:`Approaching potassium limit for ${stageName}. Leach high-potassium vegetables before cooking (soak 2+ hours, boil in fresh water, drain).`,values:`This serving: ${Math.round(n.potassium)} mg · Meal target: &lt;${Math.round(kPerMeal)} mg`});
    } else {
      flags.push({cls:'ok',icon:'✓',title:`Potassium OK — ${Math.round(n.potassium)} mg per serving`,body:`Within safe limits for ${stageName}.`,values:`${Math.round(n.potassium)} mg of ${Math.round(kPerMeal)} mg meal limit`});
    }
  } else {
    flags.push({cls:'info',icon:'ℹ',title:`Potassium — ${Math.round(n.potassium)} mg per serving`,body:`No potassium restriction needed at ${stageName}. Monitor if labs show elevated serum K.`,values:''});
  }

  // Phosphorus
  if(lim.p){
    const pPerMeal = lim.p / 3;
    if(n.phosphorus > pPerMeal * 1.5){
      flags.push({cls:'danger',icon:'🚨',title:`High Phosphorus — ${Math.round(n.phosphorus)} mg per serving`,body:`Exceeds safe limit for ${stageName}. Elevated phosphorus drives PTH secretion, vascular calcification, and cardiovascular mortality. ${stage==='HD'||stage==='PD'?'Take your phosphate binder with this meal as prescribed.':'Discuss adding a phosphate binder with your nephrologist.'}`,values:`This serving: ${Math.round(n.phosphorus)} mg · Meal target: &lt;${Math.round(pPerMeal)} mg`});
    } else if(n.phosphorus > pPerMeal){
      flags.push({cls:'warn',icon:'⚠️',title:`Phosphorus Elevated — ${Math.round(n.phosphorus)} mg per serving`,body:`Approaching phosphorus limit. Ensure phosphate binder is taken with this meal if prescribed. Watch for processed ingredients with phosphate additives (E338–E452) — actual phosphorus burden may be higher than calculated.`,values:`This serving: ${Math.round(n.phosphorus)} mg · Meal target: &lt;${Math.round(pPerMeal)} mg`});
    } else {
      flags.push({cls:'ok',icon:'✓',title:`Phosphorus OK — ${Math.round(n.phosphorus)} mg per serving`,body:`Within safe limits for ${stageName}. Still take phosphate binder with this meal if prescribed.`,values:`${Math.round(n.phosphorus)} mg of ${Math.round(pPerMeal)} mg meal limit`});
    }
  }

  // Protein
  if(stage==='HD'||stage==='PD'){
    if(n.protein < 20){
      flags.push({cls:'warn',icon:'⚠️',title:`Low Protein — ${n.protein?.toFixed(1)} g per serving`,body:`Dialysis patients need 1.0–1.5 g/kg/day. This meal is low in protein — consider adding a high biological value protein source (egg white, lean chicken, tilapia) to meet daily targets.`,values:''});
    } else {
      flags.push({cls:'ok',icon:'✓',title:`Protein Adequate — ${n.protein?.toFixed(1)} g per serving`,body:`Good protein content for a dialysis patient. Aim for 50%+ high biological value (HBV) sources.`,values:''});
    }
  } else if(['4','5','3b'].includes(stage)){
    if(n.protein > 25){
      flags.push({cls:'warn',icon:'⚠️',title:`Protein — ${n.protein?.toFixed(1)} g per serving`,body:`Pre-dialysis CKD patients are advised to moderate protein intake (0.6–0.8 g/kg/day). This meal is relatively high in protein. Consider reducing meat/fish portion slightly.`,values:''});
    }
  }

  // Fluid note (soups/stews)
  if((stage==='HD'||stage==='PD') && n.fluid_ml && n.fluid_ml > 200){
    flags.push({cls:'warn',icon:'💧',title:`Fluid Content — ~${Math.round(n.fluid_ml)} mL per serving`,body:`This recipe contains significant liquid (broth, soup, sabaw). On dialysis, all liquid sources count toward your daily fluid limit — including soup. Consider eating less sabaw or choosing drier preparations.`,values:''});
  }

  return flags;
}

// ── MAIN ANALYZE FUNCTION ─────────────────────────────────────────────
async function analyzeRecipe(){
  const ingredients = document.getElementById('f-ingredients').value.trim();
  const servings    = parseInt(document.getElementById('f-servings').value)||4;
  const servingDesc = document.getElementById('f-serving-desc').value.trim()||'1 serving';
  const recipeName  = document.getElementById('f-name').value.trim()||'Recipe';

  if(!ingredients){
    document.getElementById('api-error').textContent='Please enter at least one ingredient.';
    document.getElementById('api-error').classList.add('show');
    return;
  }
  document.getElementById('api-error').classList.remove('show');

  const btn = document.getElementById('analyze-btn');
  const spinner = document.getElementById('spinner');
  const btnText = document.getElementById('btn-text');
  btn.disabled=true; spinner.classList.add('show'); btnText.textContent='Analyzing…';

  const prompt = `You are a clinical nutritionist with expertise in Filipino food. Analyze the following recipe ingredients and return ONLY a valid JSON object — no markdown, no backticks, no explanation.

Recipe: "${recipeName}"
Total servings: ${servings}
Ingredients (total recipe):
${ingredients}

Return this exact JSON structure with numeric values per serving:
{
  "calories": number,
  "protein": number,
  "fat": number,
  "sat_fat": number,
  "trans_fat": number,
  "carbs": number,
  "fiber": number,
  "sugars": number,
  "cholesterol": number,
  "sodium": number,
  "potassium": number,
  "phosphorus": number,
  "calcium": number,
  "iron": number,
  "fluid_ml": number,
  "ingredients": [
    {
      "name": "ingredient name",
      "calories": number,
      "protein": number,
      "sodium": number,
      "potassium": number,
      "phosphorus": number
    }
  ],
  "modifications": [
    "Specific CKD-safe modification suggestion for this recipe"
  ]
}

Rules:
- All values are PER SERVING (divide total recipe by ${servings})
- fluid_ml = approximate total liquid content per serving in mL (broth, soup, water in the dish)
- For Filipino ingredients: patis = fish sauce (~1400mg sodium per tbsp), bagoong = shrimp paste (very high sodium), kangkong = water spinach (~low K), kamote = sweet potato (high K ~450mg/100g), sayote = chayote (low K ~~170mg/100g)
- Use USDA food composition data and Philippine Food Composition Tables where applicable
- For ingredients you cannot identify, use reasonable estimates
- modifications should be specific to this recipe (e.g. "Reduce patis from 1 tbsp to 1 tsp and add calamansi juice for flavor")
- Return ONLY the JSON object, nothing else`;

  try {
    const resp = await fetch('/api/analyze',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:1200,
        messages:[{role:'user',content:prompt}]
      })
    });
    const data = await resp.json();
    if(data.error){throw new Error(data.error.message||'API error');}

    const raw = data.content.filter(c=>c.type==='text').map(c=>c.text).join('');
    const clean = raw.replace(/```json|```/g,'').trim();
    const n = JSON.parse(clean);

    // Build NF label
    document.getElementById('nf-label').innerHTML = buildNFLabel(n, recipeName, servings, servingDesc);

    // Build CKD flags
    const flags = buildFlags(n, selectedStage);
    const stageLabels = {none:'General Population','1':'CKD Stage 1–2','3a':'CKD Stage 3a','3b':'CKD Stage 3b','4':'CKD Stage 4','5':'CKD Stage 5','HD':'Hemodialysis','PD':'Peritoneal Dialysis'};
    document.getElementById('flags-header').textContent = `CKD Safety — ${stageLabels[selectedStage]||'General'}`;
    document.getElementById('flags-sub').textContent = `Per serving of ${recipeName}`;
    document.getElementById('flags-list').innerHTML = flags.map(f=>`
      <div class="flag-row flag-${f.cls}">
        <div class="flag-icon">${f.icon}</div>
        <div class="flag-body">
          <h4>${f.title}</h4>
          <p>${f.body}</p>
          ${f.values?`<div class="flag-values">${f.values}</div>`:''}
        </div>
      </div>`).join('');

    // Ingredient breakdown
    if(n.ingredients && n.ingredients.length){
      const rows = n.ingredients.map(ig=>`<tr>
        <td>${ig.name}</td>
        <td>${Math.round(ig.calories)}</td>
        <td>${ig.protein?.toFixed(1)}g</td>
        <td>${Math.round(ig.sodium)}mg</td>
        <td>${Math.round(ig.potassium)}mg</td>
        <td>${Math.round(ig.phosphorus)}mg</td>
      </tr>`).join('');
      const totals = n.ingredients.reduce((a,ig)=>({
        calories:a.calories+ig.calories,protein:a.protein+ig.protein,
        sodium:a.sodium+ig.sodium,potassium:a.potassium+ig.potassium,phosphorus:a.phosphorus+ig.phosphorus
      }),{calories:0,protein:0,sodium:0,potassium:0,phosphorus:0});
      document.getElementById('ib-tbody').innerHTML = rows + `<tr>
        <td>Total per serving</td>
        <td>${Math.round(totals.calories)}</td>
        <td>${totals.protein.toFixed(1)}g</td>
        <td>${Math.round(totals.sodium)}mg</td>
        <td>${Math.round(totals.potassium)}mg</td>
        <td>${Math.round(totals.phosphorus)}mg</td>
      </tr>`;
      document.getElementById('ingredient-breakdown').style.display='block';
    } else {
      document.getElementById('ingredient-breakdown').style.display='none';
    }

    // Modification tips
    if(n.modifications && n.modifications.length){
      document.getElementById('mod-tips-wrap').innerHTML=`
        <div class="alert alert-teal">
          <div class="alert-icon">💡</div>
          <div class="alert-body">
            <h4>CKD-Safe Modifications for This Recipe</h4>
            <ul>${n.modifications.map(m=>`<li>${m}</li>`).join('')}</ul>
          </div>
        </div>`;
    }

    document.getElementById('results-wrap').classList.add('show');
    document.getElementById('results-wrap').scrollIntoView({behavior:'smooth',block:'start'});

  } catch(e){
    document.getElementById('api-error').textContent='Analysis failed: '+e.message+'. Please try again.';
    document.getElementById('api-error').classList.add('show');
  } finally {
    btn.disabled=false; spinner.classList.remove('show'); btnText.textContent='Analyze Recipe';
  }
}
</script>
</body>
</html>
