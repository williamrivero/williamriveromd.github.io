{
 "_doc": [
  "Which renalcarematters.com calculators show under 'Related guides & calculators' on drug and supplement pages.",
  "Read by tools/drugdb/build_related_guides.py. Each rule: calc = guides/<file>; match = regex (case-insensitive) tested",
  "against the generic name and each ingredient; slugs = exact generic slugs; supp = supplement ingredient/category keys",
  "(as in data/drugs/supplements, e.g. 'Iron', 'cat:ketoanalogue'). scan = true: also link the calculator to every",
  "single-ingredient generic whose name appears in the calculator page itself (for dosing tables like renal antibiotics).",
  "kidney_function: added automatically to drugs with APPROVED kidney dosing (Cockcroft-Gault when the label uses CrCl,",
  "CKD-EPI eGFR otherwise). Up to 3 calculators render per page; rules listed first win ties."
 ],
 "rules": [
  {"calc": "calc-vancomycin-auc.html", "match": "^vancomycin"},
  {"calc": "calc-aminoglycoside-dosing.html", "match": "^(gentamicin|amikacin|tobramycin|netilmicin)$"},
  {"calc": "calc-tacrolimus-dosing.html", "match": "^tacrolimus"},
  {"calc": "calc-doac-renal-dosing.html", "match": "^(apixaban|rivaroxaban|edoxaban|dabigatran)"},
  {"calc": "calc-cha2ds2-vasc.html", "match": "^(apixaban|rivaroxaban|edoxaban|dabigatran|warfarin)"},
  {"calc": "calc-has-bled.html", "match": "^(apixaban|rivaroxaban|edoxaban|dabigatran|warfarin)"},
  {"calc": "calc-metformin-ckd-safety.html", "match": "metformin"},
  {"calc": "calc-sglt2i-eligibility.html", "match": "(dapagliflozin|empagliflozin|canagliflozin|ertugliflozin|sotagliflozin|ipragliflozin|luseogliflozin)"},
  {"calc": "calc-esa-dose-adjustment.html", "match": "(epoetin|darbepoetin|methoxy polyethylene glycol|roxadustat|daprodustat|vadadustat)"},
  {"calc": "calc-iv-iron-dose.html", "match": "^(iron sucrose|ferric carboxymaltose|iron dextran|ferumoxytol|sodium ferric gluconate|ferric derisomaltose|iron isomaltoside)"},
  {"calc": "calc-iron-deficit-ganzoni.html", "match": "^(iron sucrose|ferric carboxymaltose|iron dextran|ferumoxytol|sodium ferric gluconate|ferric derisomaltose|iron isomaltoside)"},
  {"calc": "calc-iron-status-tsat.html", "match": "^(iron|ferrous|ferric|iron sucrose|epoetin|darbepoetin|roxadustat)", "supp": ["Iron"]},
  {"calc": "calc-ketoanalogue-dose.html", "match": "keto ?analogue", "supp": ["cat:ketoanalogue"]},
  {"calc": "calc-ketoanalogue-plan-check.html", "match": "keto ?analogue", "supp": ["cat:ketoanalogue"]},
  {"calc": "calc-carboplatin-calvert.html", "match": "^carboplatin"},
  {"calc": "calc-levothyroxine-dose.html", "match": "^levothyroxine"},
  {"calc": "calc-acetaminophen-nac.html", "match": "^(acetylcysteine|paracetamol)$"},
  {"calc": "calc-corticosteroid-conversion.html", "match": "^(prednisone|prednisolone|methylprednisolone|dexamethasone|hydrocortisone|betamethasone|deflazacort|triamcinolone)$"},
  {"calc": "calc-insulin-dose.html", "match": "insulin"},
  {"calc": "calc-uric-acid.html", "match": "^(allopurinol|febuxostat|benzbromarone|probenecid|rasburicase)"},
  {"calc": "calc-neuropathic-gout-renal-dosing.html", "scan": true},
  {"calc": "calc-renal-abx-dosing.html", "scan": true},
  {"calc": "calc-vitamin-d-dose.html", "match": "^(cholecalciferol|colecalciferol|ergocalciferol|calcifediol)$", "supp": ["Vitamin D3 (cholecalciferol)", "Vitamin D"]},
  {"calc": "calc-ckd-mbd.html", "match": "^(sevelamer|lanthanum|calcium acetate|sucroferric oxyhydroxide|ferric citrate|calcitriol|alfacalcidol|paricalcitol|cinacalcet|etelcalcetide)"},
  {"calc": "calc-phosphorus-load.html", "match": "^(sevelamer|lanthanum|calcium acetate|sucroferric oxyhydroxide|ferric citrate)"},
  {"calc": "calc-electrolyte-repletion.html", "match": "^(potassium chloride|magnesium sulfate|sodium phosphate|potassium phosphate)"},
  {"calc": "calc-magnesium-replacement.html", "match": "^magnesium sulfate"},
  {"calc": "calc-potassium-load.html", "match": "^(sodium polystyrene sulfonate|calcium polystyrene sulfonate|patiromer|sodium zirconium cyclosilicate)"},
  {"calc": "calc-bicarb-deficit.html", "match": "^sodium bicarbonate$"},
  {"calc": "calc-vasopressor-inotrope.html", "match": "^(norepinephrine|epinephrine|dopamine|dobutamine|vasopressin|phenylephrine|milrinone)$"},
  {"calc": "calc-vis.html", "match": "^(norepinephrine|epinephrine|dopamine|dobutamine|vasopressin|milrinone)$"},
  {"calc": "calc-4ts-hit.html", "match": "^(heparin|enoxaparin|nadroparin|dalteparin|tinzaparin)"}
 ],
 "kidney_function": {"crcl": "calc-cockcroft-gault.html", "egfr": "calc-egfr-ckd-epi.html"}
}
