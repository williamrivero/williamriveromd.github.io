# Cloudflare Pages response headers (renalcarematters.com)
# HTML keeps Cloudflare's default (revalidate every visit). Static assets and search data get
# browser caching so moving between guides, calculators and the drug database stays fast.

# Fingerprinted drug-database assets (file name = content hash): cache for a year
/drugs/drugdb.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted site navigation / phone menu (site-nav.<hash>.js, written by patch_site_nav.py)
/assets/site-nav.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted side rail (guide-rail.<hash>.js, written by patch_guide_rail.py)
/assets/guide-rail.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted appearance themes (theme.<hash>.js, theme-dim.<hash>.css, written by patch_theme_modes.py)
/assets/theme.*
  Cache-Control: public, max-age=31536000, immutable
/assets/theme-dim.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted Academy highlights & notes (academy-notes.<hash>.js, written by tools/academy/apply_notes.py)
/assets/academy-notes.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted Academy Listen player (academy-listen.<hash>.js, written by tools/academy/apply_listen.py)
/assets/academy-listen.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted Academy certificate of completion (academy-certificate.<hash>.js, tools/academy/apply_certificate.py)
/assets/academy-certificate.*
  Cache-Control: public, max-age=31536000, immutable

# Module quiz progress for the certificate (academy-progress.<hash>.js, tools/academy/apply_certificate.py)
/assets/academy-progress.*
  Cache-Control: public, max-age=31536000, immutable

# Personal Study Record (academy-study-record.<hash>.js, tools/academy/apply_study_record.py)
/assets/academy-study-record.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted Academy interactive cases (academy-cases.<hash>.js, written by tools/academy/apply_cases.py)
/assets/academy-cases.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted Academy "Updated since you read it" flags (academy-updates.<hash>.js, tools/academy/apply_updates.py)
/assets/academy-updates.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted Academy inline tools + reviewed kidney dosing data (tools/academy/apply_tools.py)
/assets/academy-tools.*
  Cache-Control: public, max-age=31536000, immutable
/assets/academy-kidney-doses.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted Academy preceptor sign-off (academy-skills.<hash>.js, written by tools/academy/apply_skills.py)
/assets/academy-skills.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted Academy review deck (academy-review.<hash>.js, written by tools/academy/apply_review.py)
/assets/academy-review.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted natural-voice worker for the Listen player (academy-piper-worker.<hash>.js, same script)
/assets/academy-piper-worker.*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted calculator design layer (calc-ui.<hash>.css/js, written by build_calc_app.py)
/assets/calc-ui.*
  Cache-Control: public, max-age=31536000, immutable

# Versioned drug-database assets (?v= changes whenever they change)
/drugs/drugdb.css
  Cache-Control: public, max-age=31536000, immutable
/drugs/drugdb.js
  Cache-Control: public, max-age=31536000, immutable

# Drug Index app: the service worker must always be checked for updates
/drugs/sw.js
  Cache-Control: no-cache
/drugs/app.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Schola (Renal Care Academy app): same rules; the offline file list must always be fresh
/academy/schola-sw.js
  Cache-Control: no-cache
/academy/schola.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
/academy/schola-offline.json
  Cache-Control: no-cache
/assets/schola.*
  Cache-Control: public, max-age=31536000, immutable

# Calculo (calculators app): same rules as the Drug Index app
/guides/calc-sw.js
  Cache-Control: no-cache
/guides/calc-app.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Shared scripts (unversioned): short cache, refreshed in the background
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Search indexes and drug/supplement data: 1 hour, refreshed in the background
/drugs/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/drugs/supplements/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/data/drugs/supplements/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/guides/search-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Images and fonts rarely change
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/brand/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
