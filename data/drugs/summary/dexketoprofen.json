    },
    {
      "drug_or_class": "Methotrexate",
      "effect": "Hematologic toxicity.",
      "action": "Avoid at 15 mg/week or more; weekly blood counts at lower doses.",
      "severity": "Avoid"
    },
    {
      "drug_or_class": "Lithium",
      "effect": "Higher lithium levels.",
      "action": "Monitor lithium.",
      "severity": "Adjust or monitor"
    },
